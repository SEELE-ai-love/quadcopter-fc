{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "files.autoGuessEncoding": true,
  "editor.formatOnSave": false,
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/gcc-Debug/compile_commands.json",
  "cmake.cmakePath": "cube-cmake",
  "cmake.configureArgs": [
    "-DCMAKE_COMMAND=cube-cmake"
  ],
  "cmake.preferredGenerators": [
    "Ninja"
  ],
  "stm32cube-ide-clangd.path": "cube",
  "stm32cube-ide-clangd.arguments": [
    "starm-clangd",
    "--query-driver=D:/STM32Cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc.exe,D:/STM32Cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++.exe"
  ],
  "[c][cpp][asm]": {
    "files.encoding": "gbk",
    "files.autoGuessEncoding": true,
    "files.candidateGuessEncodings": [
      "utf8"
    ]
  }
}
