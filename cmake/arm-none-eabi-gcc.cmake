set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GCC_ROOT "" CACHE PATH "GNU Arm toolchain installation root")
set(_gcc_hints)
if(ARM_GCC_ROOT)
    list(APPEND _gcc_hints "${ARM_GCC_ROOT}/bin")
endif()
if(DEFINED ENV{ARM_GCC_ROOT})
    list(APPEND _gcc_hints "$ENV{ARM_GCC_ROOT}/bin")
endif()
if(DEFINED ENV{CUBE_BUNDLE_PATH})
    file(GLOB _bundle_gcc_dirs LIST_DIRECTORIES true
        "$ENV{CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/*/bin")
    list(SORT _bundle_gcc_dirs COMPARE NATURAL ORDER DESCENDING)
    list(APPEND _gcc_hints ${_bundle_gcc_dirs})
endif()
find_program(_arm_gcc NAMES arm-none-eabi-gcc HINTS ${_gcc_hints} REQUIRED)
get_filename_component(_gcc_bin "${_arm_gcc}" DIRECTORY)
set(CMAKE_C_COMPILER "${_arm_gcc}")
set(CMAKE_ASM_COMPILER "${_arm_gcc}")
foreach(_tool IN ITEMS ar ranlib objcopy objdump size readelf)
    string(TOUPPER "${_tool}" _upper)
    find_program(CMAKE_${_upper} NAMES arm-none-eabi-${_tool}
        HINTS "${_gcc_bin}" NO_DEFAULT_PATH REQUIRED)
endforeach()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GCC_ROOT)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
